            </div>
        </section>

        <div id="pageNotice" class="notice"></div>

        <section class="layout-grid">
            <div class="stack">
                <div class="panel">
                    <div class="panel-head">
                        <div>
                            <h2 class="panel-title">批量生成账号</h2>
                            <div class="panel-subtitle">
                                统一按规则生成账号，并给这些账号附带“首次建角”策略。生成后可直接进入当前控制列表。
                            </div>
                        </div>
                        <div class="panel-chip">新布局</div>
                    </div>

                    <div class="soft-block" style="margin-bottom: 16px;">
                        <div class="soft-block-title">命名规则</div>
                        <div class="soft-block-value">110001 + 前缀 + 左补零编号</div>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label for="prefixInput" class="form-label">账号前缀</label>
                            <input id="prefixInput" class="form-control" placeholder="A">
                        </div>
                        <div class="field">
                            <label for="indexNumInput" class="form-label">编号位数</label>
                            <input id="indexNumInput" type="number" min="1" class="form-control" value="4">
                        </div>
                        <div class="field">
                            <label for="startIndexInput" class="form-label">起始编号</label>
                            <input id="startIndexInput" type="number" min="1" class="form-control" value="1">
                        </div>
                        <div class="field">
                            <label for="countInput" class="form-label">生成数量</label>
                            <input id="countInput" type="number" min="1" class="form-control" value="20">
                        </div>
                        <div class="field">
                            <label for="charNameModeSelect" class="form-label">角色名策略</label>
                            <select id="charNameModeSelect" class="form-select">
                                <option value="cn_random">随机中文名</option>
                                <option value="gender_pool">男女名池</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="charGenderModeSelect" class="form-label">角色性别策略</label>
                            <select id="charGenderModeSelect" class="form-select">
                                <option value="account_parity">按账号尾号</option>
                                <option value="random">随机性别</option>
                                <option value="male">固定男角</option>
                                <option value="female">固定女角</option>
