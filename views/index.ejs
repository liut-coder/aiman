                <div class="panel">
                    <div class="panel-head">
                        <div>
                            <h2 class="panel-title">导入成品号</h2>
                            <div class="panel-subtitle">已经有现成账号时，可以把账号列表直接贴进来，支持换行、空格、逗号或分号分隔。</div>
                        </div>
                        <div class="panel-chip">成品号</div>
                    </div>

                    <div class="field">
                        <label for="importAccountsInput" class="form-label">账号列表</label>
                        <textarea id="importAccountsInput" class="form-control" placeholder="每行一个账号，或使用空格 / 逗号分隔&#10;例如：&#10;110001A0001&#10;110001A0002"></textarea>
                    </div>

                    <div class="form-grid" style="margin-top: 14px;">
                        <div class="field">
                            <label for="importStartIndexInput" class="form-label">起始显示编号</label>
                            <input id="importStartIndexInput" type="number" min="1" class="form-control" value="1">
                        </div>
                        <div class="field">
                            <div class="form-check" style="height: 100%;">
                                <input class="form-check-input" type="checkbox" id="importAutoLogin">
                                <label class="form-check-label" for="importAutoLogin">导入后自动登录</label>
                            </div>
                        </div>
                        <div class="field field-wide">
                            <button id="importAccountsBtn" class="flat-btn w-100">导入到控制列表</button>
                            <div class="hint-line">账号如果没带 `110001` 前缀，系统会自动补齐并去重。</div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="stack">
                <div class="panel">
                    <div class="selected-bar">
                        <div>
                            <h2 class="panel-title" style="margin-bottom: 10px;">账号控制面板</h2>
                            <div class="selected-summary">
                                当前列表 <strong id="totalAccountsLabel">0</strong> 个账号，已勾选 <strong id="selectedAccountsLabel">0</strong> 个。
                                表格里会同时显示来源和建角策略，方便区分新生成账号与导入成品号。
                            </div>
                        </div>
                        <div class="toolbar">
                            <button id="batchLoginBtn" class="flat-btn flat-btn-primary">选中登录</button>
                            <button id="batchLogoutBtn" class="flat-btn">选中退出</button>
                            <button id="batchPrepareBtn" class="flat-btn flat-btn-success">成品准备</button>
                            <button id="batchXiangyaoBtn" class="flat-btn flat-btn-warning">选中降妖</button>
                            <button id="batchDeleteBtn" class="flat-btn flat-btn-danger">选中删除</button>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="control-table">
                            <thead>
                                <tr>
                                    <th style="width: 56px;">
                                        <input id="selectAllCheckbox" type="checkbox">
                                    </th>
                                    <th style="width: 92px;">编号</th>
                                    <th style="width: 220px;">账号</th>
                                    <th style="width: 130px;">来源</th>
                                    <th style="width: 220px;">建角策略</th>
                                    <th style="width: 130px;">AAA</th>
                                    <th style="width: 130px;">GS</th>
                                    <th style="width: 360px;">操作</th>
                                </tr>
                            </thead>
                            <tbody id="accountsTableBody">
                                <tr>
                                    <td colspan="8" class="empty-state">正在加载账号列表...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <section class="panel panel-wide-section">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">当前关键配置</h2>
                    <div class="panel-subtitle">这一组已经改成横向卡片预览，方便在首页直接扫一眼默认密码、邮件参数、世界关键词和本地语料概况。</div>
                </div>
                <a href="/config" class="panel-chip" style="text-decoration: none;">打开配置页</a>
            </div>

            <div id="configPreview" class="config-grid">
                <div class="config-item">
                    <strong>读取中</strong>
                    <code>正在加载配置预览...</code>
                </div>
            </div>

            <div class="config-note">
                `world_chat` 现在会作为“自定义补充词库”叠加到本地语料文件 `data/chat_corpus.json` 上一起参与自动喊话。
            </div>
        </section>
    </div>

    <script src="../bootstrap-5.3.0-alpha1-dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const state = {
            userDatas: [],
            config: {},
            chatCorpusSummary: null,
            selectedAccounts: new Set(),
            instance: null
        };

        const BATCH_SETTINGS_KEY = 'batchGeneratePreferences';
        const messageMap = {
            prefix_required: '请输入账号前缀。',
            count_invalid: '生成数量必须大于 0。',
            start_index_invalid: '起始编号必须大于 0。',
            accounts_empty: '请至少输入一个账号。'
        };
        const sourceLabelMap = {
            batch_generate: '批量生成',
            manual_import: '手动导入'
        };
        const charNameModeLabelMap = {
            cn_random: '随机中文名',
            gender_pool: '男女名池'
        };
        const charGenderModeLabelMap = {
            account_parity: '按账号尾号',
            random: '随机性别',
            male: '固定男角',
            female: '固定女角'
        };
        const chatSceneLabelMap = {
            global: '世界',
            team: '组队',
            zhuxian: '主线',
            shimen: '师门',
            bangpai: '帮派',
            chubao: '除暴',
            xiangyao: '降妖'
        };

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function shortenText(value, maxLength = 60) {
            const text = String(value ?? '').trim();
            if (text.length <= maxLength) return text || '-';
            return `${text.slice(0, maxLength)}...`;
        }

        function showNotice(message, type = 'success') {
            const notice = document.getElementById('pageNotice');
            notice.className = `notice show ${type === 'error' ? 'notice-error' : 'notice-success'}`;
            notice.textContent = message;
            window.clearTimeout(showNotice.timer);
            showNotice.timer = window.setTimeout(() => {
                notice.className = 'notice';
                notice.textContent = '';
            }, 3200);
        }

        async function requestJson(url, options = {}) {
            const response = await fetch(url, options);
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
        }

        function getResultMessage(result, fallbackMessage) {
            if (result && typeof result.message === 'string' && result.message.trim()) {
                return result.message;
            }
            return fallbackMessage;
        }

        function normalizeStatus(statusText, type) {
            const value = statusText || '未知';
            if (type === 'aaa') {
                if (value === '已连接') return ['status-ok', value];
                if (value === '未连接' || value === '不存在该连接') return ['status-bad', value];
                return ['status-warn', value];
            }

            if (value === '连接') return ['status-ok', value];
            if (value === '未连接' || value === '不存在该连接') return ['status-bad', value];
            return ['status-warn', value];
        }

        function formatSource(source) {
            return sourceLabelMap[source] || '默认';
        }

        function formatCharacterProfile(item) {
            const nameModeLabel = charNameModeLabelMap[item.charNameMode] || charNameModeLabelMap.cn_random;
            const genderModeLabel = charGenderModeLabelMap[item.charGenderMode] || charGenderModeLabelMap.account_parity;

            return `
                <div class="meta-stack">
                    <span class="meta-pill">${escapeHtml(nameModeLabel)}</span>
                    <span class="meta-pill muted">${escapeHtml(genderModeLabel)}</span>
                </div>
            `;
        }

        function formatOwnership(item) {
            const ownerText = item.ownerStatusLabel || '未归属';
            const leaseText = item.ownerLeaseUntilLabel ? ` · 到期 ${item.ownerLeaseUntilLabel}` : '';
            return `<div class="account-meta"><strong>归属</strong> ${escapeHtml(ownerText)}${escapeHtml(leaseText)}</div>`;
        }

        function formatRoleInfo(item) {
            const roleName = String(item.roleName || '').trim();
            if (!roleName) {
                return '<div class="role-empty">暂未拿到角色名</div>';
            }

            const metaParts = [];
            if (item.level !== '' && item.level !== null && item.level !== undefined) {
                metaParts.push(`Lv.${escapeHtml(item.level)}`);
            }
            if (item.mapName) {
                metaParts.push(escapeHtml(item.mapName));
            }
            if (item.chatScene && chatSceneLabelMap[item.chatScene]) {
                metaParts.push(`${escapeHtml(chatSceneLabelMap[item.chatScene])}中`);
            }

            return `
                <div class="role-name">${escapeHtml(roleName)}</div>
                ${metaParts.length ? `<div class="role-meta">${metaParts.join(' · ')}</div>` : ''}
            `;
        }

        function updateSelectedCounter() {
            const selected = state.userDatas.filter(item => state.selectedAccounts.has(item.account));
            document.getElementById('selectedAccountsLabel').textContent = selected.length;
            document.getElementById('totalAccountsLabel').textContent = state.userDatas.length;

            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            if (!state.userDatas.length) {
                selectAllCheckbox.checked = false;
                return;
            }
            selectAllCheckbox.checked = selected.length === state.userDatas.length;
        }

        function renderTable() {
            const tbody = document.getElementById('accountsTableBody');
            const validAccounts = new Set(state.userDatas.map(item => item.account));
            state.selectedAccounts.forEach(account => {
                if (!validAccounts.has(account)) {
                    state.selectedAccounts.delete(account);
                }
            });

            if (!state.userDatas.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="empty-state">当前还没有账号，先批量生成或导入成品号。</td></tr>';
                updateSelectedCounter();
                return;
            }

            tbody.innerHTML = state.userDatas.map(item => {
                const aaaStatus = normalizeStatus(item.aaa, 'aaa');
                const gsStatus = normalizeStatus(item.gs, 'gs');
                const checked = state.selectedAccounts.has(item.account) ? 'checked' : '';
                const source = formatSource(item.source);
                const lockedByOther = item.ownerActive && !item.ownedByCurrentInstance && item.ownerInstanceId;
                const disabledAttr = lockedByOther ? 'disabled title="该账号正被其他实例占用"' : '';

                return `
                    <tr>
                        <td>
                            <input class="row-selector" type="checkbox" data-account="${escapeHtml(item.account)}" ${checked}>
                        </td>
                        <td>${escapeHtml(item.index ?? '')}</td>
                        <td>
                            <span class="account-code">${escapeHtml(item.account)}</span>
                            ${formatOwnership(item)}
                        </td>
                        <td>${escapeHtml(source)}</td>
                        <td>${formatCharacterProfile(item)}</td>
                        <td><span class="status-badge ${aaaStatus[0]}">${escapeHtml(aaaStatus[1])}</span></td>
                        <td><span class="status-badge ${gsStatus[0]}">${escapeHtml(gsStatus[1])}</span></td>
                        <td>
                            <div class="row-actions">
                                <button class="flat-btn flat-btn-primary row-action" data-action="login" data-account="${escapeHtml(item.account)}" ${disabledAttr}>登录</button>
                                <button class="flat-btn row-action" data-action="logout" data-account="${escapeHtml(item.account)}" ${disabledAttr}>退出</button>
                                <button class="flat-btn flat-btn-success row-action" data-action="prepare" data-account="${escapeHtml(item.account)}" ${disabledAttr}>成品准备</button>
                                <button class="flat-btn flat-btn-warning row-action" data-action="xiangyao" data-account="${escapeHtml(item.account)}" ${disabledAttr}>降妖</button>
                                <button class="flat-btn flat-btn-danger row-action" data-action="delete" data-account="${escapeHtml(item.account)}" ${disabledAttr}>删除</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            updateSelectedCounter();
        }

        function renderConfigPreview() {
            const preview = document.getElementById('configPreview');
            const corpusSummary = state.chatCorpusSummary;
            const corpusLabel = corpusSummary
                ? `${corpusSummary.totalCategories || 0} 类 / ${corpusSummary.totalMessages || 0} 句`
                : '加载中...';
            const corpusScenes = corpusSummary && Array.isArray(corpusSummary.categories)
                ? corpusSummary.categories.slice(0, 4).map(item => chatSceneLabelMap[item.key] || item.key).join(', ')
                : '';
            const items = [
                ['账号前缀', state.config.users_prefix || ''],
                ['账号位数', state.config.users_index_num || ''],
                ['默认密码', state.config.users_pass || ''],
                ['组队关键词', shortenText(state.config.world_Team || '', 72)],
                ['自动喊话词', shortenText(state.config.world_chat || '', 72)],
                ['本地语料', corpusScenes ? `${corpusLabel} · ${corpusScenes}` : corpusLabel],
                ['经验邮件', state.config.mail_name || ''],
                ['装备邮件', state.config.mail_equip || ''],
                ['宠物邮件', state.config.mail_pet || ''],
                ['参战宠物', state.config.War_pet || ''],
                ['乘骑坐骑', state.config.Ride_pet || ''],
                ['飞行法宝', state.config.equip_fly || ''],
                ['会员类型', state.config.vip_type || '']
            ];

            preview.innerHTML = items.map(([label, value]) => `
                <div class="config-item">
                    <strong>${escapeHtml(label)}</strong>
                    <code>${escapeHtml(String(value || '-'))}</code>
                </div>
            `).join('');
        }

        async function loadChatCorpusSummary() {
            try {
                state.chatCorpusSummary = await requestJson('/api/chat-corpus/summary');
                renderConfigPreview();
            } catch (error) {
                console.error(error);
            }
        }

        async function refreshStats() {
            try {
                const data = await requestJson('/api/checkConnections');
                document.getElementById('allConnect').textContent = data.allConnect ?? 0;
                document.getElementById('connectAAA').textContent = data.connectAAA ?? 0;
                document.getElementById('connectGs').textContent = data.connectGs ?? 0;
                document.getElementById('lostConnect').textContent = data.lostConnect ?? 0;
            } catch (error) {
                console.error(error);
            }
        }

        async function refreshUserData() {
            try {
                const data = await requestJson('/api/getUserDataList');
                state.userDatas = data.userDatas || [];
                state.instance = data.instance || null;
                renderTable();
            } catch (error) {
                console.error(error);
                showNotice('刷新账号列表失败。', 'error');
            }
        }

        function updateGeneratePreview() {
            const prefix = document.getElementById('prefixInput').value.trim() || 'A';
            const indexNum = Math.max(1, Number(document.getElementById('indexNumInput').value || 4));
            const startIndex = Math.max(1, Number(document.getElementById('startIndexInput').value || 1));
            const serial = String(startIndex).padStart(indexNum, '0');
            document.getElementById('generatePreviewValue').textContent = `110001${prefix}${serial}`;
        }

        function collectBatchDraft() {
            return {
                prefix: document.getElementById('prefixInput').value.trim(),
                indexNum: document.getElementById('indexNumInput').value,
                startIndex: document.getElementById('startIndexInput').value,
                count: document.getElementById('countInput').value,
                charNameMode: document.getElementById('charNameModeSelect').value,
                charGenderMode: document.getElementById('charGenderModeSelect').value,
                autoLogin: document.getElementById('generateAutoLogin').checked
            };
        }

        function saveBatchDraft() {
            try {
                window.localStorage.setItem(BATCH_SETTINGS_KEY, JSON.stringify(collectBatchDraft()));
            } catch (error) {
                console.error(error);
            }
        }

        function restoreBatchDraft() {
            try {
                const raw = window.localStorage.getItem(BATCH_SETTINGS_KEY);
                if (!raw) return;
                const draft = JSON.parse(raw);

                if (draft.prefix !== undefined) document.getElementById('prefixInput').value = draft.prefix;
                if (draft.indexNum) document.getElementById('indexNumInput').value = draft.indexNum;
                if (draft.startIndex) document.getElementById('startIndexInput').value = draft.startIndex;
                if (draft.count) document.getElementById('countInput').value = draft.count;
                if (draft.charNameMode) document.getElementById('charNameModeSelect').value = draft.charNameMode;
                if (draft.charGenderMode) document.getElementById('charGenderModeSelect').value = draft.charGenderMode;
                if (typeof draft.autoLogin === 'boolean') document.getElementById('generateAutoLogin').checked = draft.autoLogin;
            } catch (error) {
                console.error(error);
            }
        }

        async function loadConfig() {
            try {
                state.config = await requestJson('/api/getConfig');
                if (!document.getElementById('prefixInput').value) {
                    document.getElementById('prefixInput').value = state.config.users_prefix || '';
                }
                if (!document.getElementById('indexNumInput').value) {
                    document.getElementById('indexNumInput').value = state.config.users_index_num || 4;
                }
                renderConfigPreview();
                updateGeneratePreview();
            } catch (error) {
                console.error(error);
                showNotice('读取配置失败。', 'error');
            }
        }

        function getSelectedAccounts() {
            return state.userDatas
                .filter(item => state.selectedAccounts.has(item.account))
                .map(item => item.account);
        }

        async function runBatchAction(url, accounts, successMessage) {
            if (!accounts.length) {
                showNotice('请先勾选账号。', 'error');
                return;
            }

            try {
                const result = await requestJson(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accounts })
                });
                showNotice(getResultMessage(result, successMessage));
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('批量操作失败。', 'error');
            }
        }

        document.getElementById('refreshPageBtn').addEventListener('click', async () => {
            await refreshUserData();
            await refreshStats();
            showNotice('列表已刷新。');
        });

        document.getElementById('loginAllBtn').addEventListener('click', async () => {
            try {
                await requestJson('/api/loginAllClient');
                showNotice('已触发全部登录。');
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('全部登录失败。', 'error');
            }
        });

        document.getElementById('logoutAllBtn').addEventListener('click', async () => {
            try {
                await requestJson('/api/logoutAll');
                showNotice('已触发全部退出。');
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('全部退出失败。', 'error');
            }
        });

        document.getElementById('xiangyaoAllBtn').addEventListener('click', async () => {
            try {
                await requestJson('/api/allXiangYao');
                showNotice('已触发全部降妖。');
            } catch (error) {
                console.error(error);
                showNotice('全部降妖失败。', 'error');
            }
        });

        document.getElementById('exitBtn').addEventListener('click', async () => {
            if (!window.confirm('确认停止当前进程吗？')) return;
            try {
                await requestJson('/api/exit');
            } catch (error) {
                console.error(error);
            }
        });

        document.getElementById('generateAccountsBtn').addEventListener('click', async () => {
            const prefix = document.getElementById('prefixInput').value.trim();
            const indexNum = Number(document.getElementById('indexNumInput').value || 4);
            const startIndex = Number(document.getElementById('startIndexInput').value || 1);
            const count = Number(document.getElementById('countInput').value || 0);
            const autoLogin = document.getElementById('generateAutoLogin').checked;
            const charNameMode = document.getElementById('charNameModeSelect').value;
            const charGenderMode = document.getElementById('charGenderModeSelect').value;

            try {
                const result = await requestJson('/api/accounts/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prefix, indexNum, startIndex, count, autoLogin, charNameMode, charGenderMode })
                });
                if (!result.success) {
                    showNotice(messageMap[result.message] || '批量生成失败。', 'error');
                    return;
                }
                saveBatchDraft();
                showNotice(`已生成 ${result.created.length} 个账号。`);
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('批量生成失败。', 'error');
            }
        });

        document.getElementById('importAccountsBtn').addEventListener('click', async () => {
            const accountsText = document.getElementById('importAccountsInput').value;
            const startIndex = Number(document.getElementById('importStartIndexInput').value || 1);
            const autoLogin = document.getElementById('importAutoLogin').checked;

            try {
                const result = await requestJson('/api/accounts/import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accountsText, startIndex, autoLogin })
                });
                if (!result.success) {
                    showNotice(messageMap[result.message] || '导入成品号失败。', 'error');
                    return;
                }
                showNotice(`已导入 ${result.created.length} 个账号。`);
                document.getElementById('importAccountsInput').value = '';
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('导入成品号失败。', 'error');
            }
        });

        document.getElementById('batchLoginBtn').addEventListener('click', async () => {
            await runBatchAction('/api/accounts/login', getSelectedAccounts(), '已触发选中账号登录。');
        });

        document.getElementById('batchLogoutBtn').addEventListener('click', async () => {
            await runBatchAction('/api/accounts/logout', getSelectedAccounts(), '已触发选中账号退出。');
        });

        document.getElementById('batchPrepareBtn').addEventListener('click', async () => {
            await runBatchAction('/api/accounts/prepare-finished', getSelectedAccounts(), '已触发选中账号成品准备。');
        });

        document.getElementById('batchXiangyaoBtn').addEventListener('click', async () => {
            await runBatchAction('/api/accounts/xiangyao', getSelectedAccounts(), '已触发选中账号降妖。');
        });

        document.getElementById('batchDeleteBtn').addEventListener('click', async () => {
            const accounts = getSelectedAccounts();
            if (!accounts.length) {
                showNotice('请先勾选账号。', 'error');
                return;
            }
            if (!window.confirm(`确认删除选中的 ${accounts.length} 个账号吗？`)) return;

            try {
                await requestJson('/api/accounts/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accounts })
                });
                accounts.forEach(account => state.selectedAccounts.delete(account));
                showNotice('已删除选中账号。');
                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('删除账号失败。', 'error');
            }
        });

        document.getElementById('selectAllCheckbox').addEventListener('change', event => {
            if (event.target.checked) {
                state.userDatas.forEach(item => state.selectedAccounts.add(item.account));
            } else {
                state.selectedAccounts.clear();
            }
            renderTable();
        });

        document.getElementById('accountsTableBody').addEventListener('change', event => {
            if (!event.target.classList.contains('row-selector')) return;

            const account = event.target.getAttribute('data-account');
            if (event.target.checked) {
                state.selectedAccounts.add(account);
            } else {
                state.selectedAccounts.delete(account);
            }
            updateSelectedCounter();
        });

        document.getElementById('accountsTableBody').addEventListener('click', async event => {
            const button = event.target.closest('.row-action');
            if (!button) return;

            const account = button.getAttribute('data-account');
            const action = button.getAttribute('data-action');

            try {
                if (action === 'login') {
                    await requestJson('/api/createLoginClinet', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ account })
                    });
                    showNotice(`已触发 ${account} 登录。`);
                } else if (action === 'logout') {
                    await requestJson('/api/logoutSingleAccount', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ account })
                    });
                    showNotice(`已触发 ${account} 退出。`);
                } else if (action === 'prepare') {
                    await requestJson('/api/accounts/prepare-finished', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ accounts: [account] })
                    });
                    showNotice(`已触发 ${account} 成品准备。`);
                } else if (action === 'xiangyao') {
                    await requestJson('/api/accounts/xiangyao', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ accounts: [account] })
                    });
                    showNotice(`已触发 ${account} 降妖。`);
                } else if (action === 'delete') {
                    if (!window.confirm(`确认删除账号 ${account} 吗？`)) return;
                    await requestJson('/api/accounts/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ accounts: [account] })
                    });
                    state.selectedAccounts.delete(account);
                    showNotice(`已删除 ${account}。`);
                }

                await refreshUserData();
                await refreshStats();
            } catch (error) {
                console.error(error);
                showNotice('单账号操作失败。', 'error');
            }
        });

        [
            'prefixInput',
            'indexNumInput',
            'startIndexInput',
            'countInput',
            'charNameModeSelect',
            'charGenderModeSelect',
            'generateAutoLogin'
        ].forEach(id => {
            document.getElementById(id).addEventListener('input', () => {
                updateGeneratePreview();
                saveBatchDraft();
            });
            document.getElementById(id).addEventListener('change', () => {
                updateGeneratePreview();
                saveBatchDraft();
            });
        });

        async function initPage() {
            restoreBatchDraft();
            await loadConfig();
            await loadChatCorpusSummary();
            updateGeneratePreview();
            await refreshUserData();
            await refreshStats();
            window.setInterval(refreshStats, 2000);
            window.setInterval(refreshUserData, 4000);
        }

        initPage();
    </script>
</body>
</html>
